{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/shadcn_guard.py\" context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/shadcn_guard.py\" check"
          }
        ]
      }
    ]
  }
}
